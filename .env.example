
# FinPath environment configuration template
# Use placeholders only. Never put real credentials in this file.

# MySQL database (for deployment)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/finpath
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT signing secret — set a strong, unique value outside this file
JWT_SECRET=replace_with_a_new_random_secret_of_at_least_32_bytes

# Optional AI provider configuration
FINPATH_AI_PROVIDER=local
FINPATH_AI_API_KEY=

# Legal placeholders — replace before public launch
PROJECT_OWNER_CONTACT_EMAIL=replace_with_your_contact_email
PROJECT_GOVERNING_JURISDICTION=replace_with_your_jurisdiction
