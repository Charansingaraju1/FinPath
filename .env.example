# FinPath Environment Configuration Template
# Use placeholders only. Never put real credentials in this file.

# Active Spring Profile (use "dev" for local H2, "postgres" for Render deployment)
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL Database (Render configuration)
# Note: Render provides "postgres://...", but Spring Boot requires "jdbc:postgresql://..."
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=your_postgres_username
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Signing Secret (must be at least 256-bit / 32-bytes random string)
JWT_SECRET=replace_with_a_new_random_secret_of_at_least_32_bytes

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Frontend API URL (for Vercel deployment)
VITE_API_URL=https://your-backend.onrender.com

# Optional AI Provider Configuration
FINPATH_AI_PROVIDER=local
FINPATH_AI_API_KEY=

# Legal Placeholders - replace before public launch
PROJECT_OWNER_CONTACT_EMAIL=replace_with_your_contact_email
PROJECT_GOVERNING_JURISDICTION=replace_with_your_jurisdiction
